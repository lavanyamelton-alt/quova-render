# Set these in the host's environment settings (Netlify / Railway / Vercel / Render).
# Nothing in the code is tied to one hosting account or domain.

# Required: token for the jobs API.
API_TOKEN=

# Optional: jobs API base (default: https://infinity.jobsearchhelp4u.com/core13).
API_URL=

# Optional: canonical origin, e.g. https://www.example.com. Leave empty to use the
# host's own URL (Netlify site URL, RAILWAY_PUBLIC_DOMAIN, VERCEL_PROJECT_PRODUCTION_URL,
# RENDER_EXTERNAL_URL). Set it as soon as a custom domain is added.
SITE_URL=

# Optional: brand name override (default comes from site-config.json).
BRAND_NAME=

# Optional: domain the "Apply" buttons point to (default: https://iwfh.currentaffairsadda22.com).
APPLY_DOMAIN=
